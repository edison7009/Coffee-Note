{
  "name": "coffee-note",
  "private": true,
  "version": "0.1.0",
  "description": "A local-first note system with tier-based organization and AI assistance.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "dsh:install": "npm install --prefix dsh-runtime --omit=dev --no-audit --no-fund",
    "dsh:ci": "npm ci --prefix dsh-runtime --omit=dev --no-audit --no-fund",
    "dsh:pack": "node scripts/pack-dsh-runtime.mjs",
    "dsh:smoke": "npm --prefix dsh-runtime run smoke",
    "catalog:build": "node scripts/build-local-catalog.mjs",
    "library:check": "node scripts/check-bilingual-library.mjs",
    "preview": "vite preview",
    "release:check": "node scripts/check-release-version.mjs",
    "test": "node --test tests/*.test.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "codemirror": "^6.0.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "qrcode": "^1.5.4",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/qrcode": "^1.5.5",
    "@vitejs/plugin-react": "^4.3.4",
    "smol-toml": "^1.8.0",
    "tar": "^7.4.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
